{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/image_gate.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/usage_report.py\" --hook-subagent-stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Ff]igma.*__(use_figma|upload_assets|create_new_file|generate_figma_design|generate_diagram|create_shader|update_shader|create_generative_plugin|update_generative_plugin|add_code_connect_map|send_code_connect_mappings)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/figma_guard.py\""
          }
        ]
      }
    ]
  }
}